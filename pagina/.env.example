# ============================================
# Variables de Entorno — TraumaVision AI
# ============================================
# 1. Copiá este archivo y renombralo a ".env"
# 2. Completá cada variable con tus valores
# 3. El .env está en .gitignore — nunca lo subas

# --- Clave de firma de las sesiones (OBLIGATORIA) ---
# Generala con: python -c "import secrets; print(secrets.token_hex(32))"
# Si falta, la app arranca con una clave efímera y avisa: las sesiones se
# invalidan en cada reinicio.
SECRET_KEY=

# Duración de la sesión en segundos (default: 8 horas)
SESSION_MAX_AGE_SECONDS=28800
# Poner en true cuando se sirva por HTTPS
SESSION_HTTPS_ONLY=false

# --- Orígenes permitidos para CORS, separados por coma ---
# Nunca usar "*": con credenciales el navegador rechaza el comodín.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Modo demo ---
# true  = al iniciar crea las 10 cuentas fijas de demostración (cada una con
#         su contraseña real, distinta por cuenta) y lista en la pantalla de
#         login las credenciales de las 9 cuentas SIN privilegio. La cuenta
#         admin se crea igual pero NO se publica: su contraseña está sólo en
#         app/database/demo_seed.py.
# false = no crea nada ni muestra nada (default seguro). Como la app no tiene
#         alta de usuarios, con false y una base vacía no hay forma de entrar.
# Poné esto en "true" A PROPÓSITO y sólo para una demo local (127.0.0.1):
# publica contraseñas conocidas en la portada.
DEMO_MODE=false

# --- Base de datos ---
DATABASE_URL=sqlite:///./traumavision.db

# --- Modelo ---
# Ruta del checkpoint de muñeca pediátrica (único modelo en producción).
# Es el mismo default de config/settings.py: las métricas que publica la
# pantalla (MODEL_METADATA) se midieron sobre ESTE checkpoint. Apuntar acá a
# otro hace que la app calcule con un modelo y publique los números de otro.
YOLO_MODEL_MUNECA=../modelo/v1r/weights/best.pt

# Umbral para DIBUJAR una caja (hallazgo de referencia)
CONFIDENCE_THRESHOLD=0.15
# Umbral para CLASIFICAR el estudio como anormal
ABNORMAL_THRESHOLD=0.22

# --- Preprocesamiento ---
# El dataset de entrenamiento tiene CLAHE aplicado. Dejar en true para que la
# inferencia vea la misma distribución que vio el modelo al entrenar.
APPLY_CLAHE_AT_INFERENCE=true
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_SIZE=8

# --- Umbrales de urgencia (OPERATIVOS, sobre el score del detector) ---
# Ver la advertencia metodológica en config/settings.py antes de citarlos.
URGENCY_HIGH_THRESHOLD=0.85
# URGENCY_MED_THRESHOLD queda atado a ABNORMAL_THRESHOLD: es la misma
# frontera clínica. Definirlo acá los desincroniza otra vez.
